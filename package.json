{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-nexusnv-github-sidebar",
  "version": "0.1.0",
  "private": true,
  "description": "Project-level GitHub workbench for OpenCode V2: pull requests, issues, and worktree-backed sessions in the sidebar.",
  "type": "module",
  "license": "MIT",
  "author": "nexusnv",
  "homepage": "https://github.com/nexusnv/opencode-nexusnv-github-sidebar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nexusnv/opencode-nexusnv-github-sidebar.git"
  },
  "bugs": {
    "url": "https://github.com/nexusnv/opencode-nexusnv-github-sidebar/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "github",
    "pull-requests",
    "issues",
    "sidebar",
    "tui"
  ],
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx",
    "./rpc": "./src/rpc.ts"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test scripts",
    "lint:fix": "oxlint --fix src test scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "audit": "bun run scripts/audit.ts",
    "pack:check": "bun run scripts/assert-pack.ts"
  },
  "dependencies": {
    "open": "11.0.4"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.8",
    "@opentui/solid": ">=0.6.8",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "2.1.4",
    "@opentui/core": "0.6.8",
    "@opentui/solid": "0.6.8",
    "@types/bun": "1.4.4",
    "@types/node": "24.12.2",
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "solid-js": "1.9.17",
    "typescript": "5.9.3"
  }
}
